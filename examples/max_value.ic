// The classic, specified as three honest properties instead of an formula.
// ic finds `max(a, b)` (or an equivalent) and the PROVER certifies it.
spec max_value(a: int[0..127], b: int[0..127])
  returns (r: int[0..127])
  ensures  r >= a
  ensures  r >= b
  ensures  r == a || r == b
  example (3, 9) => (9)
  example (9, 3) => (9)
  example (5, 5) => (5)
