spec nested(n: int[0..4])
  returns (s: int[0..10])
  locals (i: int[0..5], j: int[0..5], c: int[0..10])
  ensures s == n + 1
{
  i := 0;
  c := 0;
  while i <= n
    invariant c == i
    invariant i >= 0
    invariant i <= n + 1
    decreases n - i + 1
  {
    j := 0;
    while j <= n
      invariant j >= 0
      invariant j <= n + 1
      decreases n - j + 1
    { j := j + 1; }
    c := c + 1;
    i := i + 1;
  }
  s := c;
}
